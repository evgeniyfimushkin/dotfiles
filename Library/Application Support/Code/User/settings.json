{
    "editor.fontLigatures": false,
    "editor.fontFamily": "'JetBrains Mono', 'monospace', monospace",
    "files.refactoring.autoSave": false,
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "redhat.telemetry.enabled": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "roo-cline.allowedCommands": [],
    "roo-cline.deniedCommands": [],
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "prettier.printWidth": 120,
    "prettier.tabWidth": 4,
    "[nix]": {
        "editor.defaultFormatter": "jnoortheen.nix-ide",
    },
    "[properties]": {
        "editor.defaultFormatter": "foxundermoon.shell-format",
    },
    "[docker]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": null,
    },
    "shellformat.effectLanguages": [
        "shellscript",
        "dotenv",
        "hosts",
        "jvmoptions",
        "ignore",
        "gitignore",
        "properties",
        "spring-boot-properties",
        "azcli",
        "bats",
    ],
    "[dockerfile]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": null,
    },
    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format",
    },
    "editor.wordWrap": "on",
    "editor.formatOnSave": true,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "explorer.confirmPasteNative": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "vim.vimrc.enable": true,
    "vim.vimrc.path": "~/.vim/vimrc",
    "vim.smartRelativeLine": true,
    "vim.useSystemClipboard": true,
    "roo-cline.debug": false,
    "workbench.settings.applyToAllProfiles": [],
    "editor.fontSize": 14,
    "vscode-yandex-arc.arcStatusUpdateMode": "delayed",
    "yandex-code-assist.allowedCommands": [
        "npm test",
        "npm install",
        "tsc",
        "git log",
        "git diff",
        "git show"
    ],
    "yandex-code-assist.deniedCommands": [],
    "claudeCode.preferredLocation": "sidebar",
    "python.analysis.indexing": false,
    "python.analysis.indexing.followSymlinkedFolders": false,
    // --- Не следить за FUSE-деревом Аркадии (главная причина нагрузки на arc-демон) ---
    "files.watcherExclude": {
        "**/.arc/**": true,
        "/Users/evgeniyfim/arcadia/**": true
    },
    // --- Поиск: не ходить по симлинкам и не индексировать на лету ---
    "search.followSymlinks": false,
    "search.searchOnType": false,
    // --- Git-расширение не понимает arc; не сканировать вложенные репозитории ---
    "git.autorepositoryDetection": "openEditors",
    "scm.autoReveal": false,
    "explorer.autoReveal": false,
    // --- Меньше фоновых обходчиков дерева ---
    "npm.autoDetect": "off",
    "task.autoDetect": "off",
}
