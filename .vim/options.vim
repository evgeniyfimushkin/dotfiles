set number
set relativenumber

syntax on
filetype plugin indent on
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4

set mouse=a
set wrap
set ignorecase
set hidden
set scrolloff=8

" Clipboard
set clipboard=unnamed

" Persistent undo
set undofile
set undodir=~/.vim/undo

" Search
set incsearch
set hlsearch

" LSP responsiveness
set updatetime=300
set signcolumn=yes
